{
  "name": "dota-picker-overlay",
  "productName": "Dota Picker",
  "version": "0.2.0",
  "description": "Overlay Dota 2 per suggerimenti di pick in draft",
  "author": "Muqqqa",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.muqqqa.dotapicker",
    "productName": "Dota Picker",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "!src/engine/tools/**",
      "!src/engine/selfcheck.js"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DotaPicker-${version}-portable.exe"
    }
  }
}
